{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may only call the app's own commands: app info, the vault (status, setup, confirm recovery key saved, unlock, lock, change password, new password after a recovery unlock, new recovery key), screenshot protection (allow for 10 minutes, protect now) and the alpha's data commands. No plugins: no shell, fs, http or opener.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-vault-status",
    "allow-vault-setup",
    "allow-vault-confirm-recovery-saved",
    "allow-unlock",
    "allow-lock",
    "allow-change-password",
    "allow-set-new-password",
    "allow-regenerate-recovery-key",
    "allow-allow-capture",
    "allow-protect-capture",
    "allow-load-prefs",
    "allow-save-pref",
    "allow-list-projects",
    "allow-create-project",
    "allow-update-project",
    "allow-list-entries",
    "allow-create-entry",
    "allow-update-entry",
    "allow-add-entry-minutes",
    "allow-delete-entry",
    "allow-restore-entry",
    "allow-add-entry-tickets",
    "allow-remove-ticket",
    "allow-quick-log",
    "allow-parse-capture-line",
    "allow-capture-log",
    "allow-tray-day",
    "allow-tray-add",
    "allow-tray-set-minutes",
    "allow-tray-remove",
    "allow-tray-restore",
    "allow-ribbon",
    "allow-week-sheet",
    "allow-list-ticks",
    "allow-set-tick",
    "allow-list-timesheet-codes",
    "allow-save-timesheet-code",
    "allow-category-codes",
    "allow-set-category-code",
    "allow-list-custom-fields",
    "allow-save-custom-field",
    "allow-delete-custom-field",
    "allow-list-custom-values",
    "allow-set-custom-value",
    "allow-list-inbox",
    "allow-search",
    "allow-add-inbox",
    "allow-set-inbox-deleted"
  ]
}
